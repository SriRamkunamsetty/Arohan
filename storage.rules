rules_version = '2';

// Firebase Storage Security Rules for AROHAN.
// The Admin SDK used by trusted backend services bypasses these client rules.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function operator() {
      return signedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'operator'
      );
    }

    function validImage() {
      return request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /arohan/snapshots/{fileName} {
      allow read: if operator();
      allow create: if operator()
        && validImage()
        && request.resource.metadata.nodeId != null;
      allow update: if false;
      allow delete: if request.auth.token.role == 'admin';
    }

    match /arohan/alerts/{alertId}/{fileName} {
      allow read: if operator();
      allow create: if operator()
        && validImage()
        && request.resource.metadata.alertId == alertId;
      allow update: if false;
      allow delete: if request.auth.token.role == 'admin';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
